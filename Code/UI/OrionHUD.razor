@using Sandbox
@using Sandbox.UI
@using System.Linq
@using System;
@inherits PanelComponent

<root style="pointer-events: @((IsDead || IsChatOpen) ? "all" : "none")">
    <div class="hud-root @(IsDead ? "is-dead" : "")">

        <div class="damage-vignette" @ref="DamageVignette"></div>
        <div class="crosshair-dot"></div>

        @* Top Center: Lockdown Banner *@
        @if (ShowDenied)
        {
            <div class="lockdown-banner">
                <label class="banner-text">LOCKDOWN IN PROGRESS</label>
            </div>
        }

        @* Bottom Left Stack (1.1x Scale) *@
        <div class="bottom-left-stack upscale-hud">
            
            @* Controls Bar - Dark text on white keys *@
            <div class="controls-bar">
                <div class="control-item"><div class="key">ENTER</div><label>Chat</label></div>
                <div class="control-item"><div class="key">TAB</div><label>Menu</label></div>
                <div class="control-item"><div class="key">B</div><label>XP</label></div>
                <div class="control-item"><div class="key">V</div><label>Voice</label></div>
            </div>

            @* Player Identity Card (Widened to 480px) *@
            <div class="player-identity-card">
                <img class="steam-avatar" src="avatar:@Game.SteamId" />

                <div class="identity-info">
                    <div class="name-row">
                        <label class="player-name">@LocalName</label>
                        <div class="badge-group">
                            @* Combined Progression Badge *@
                            <div class="level-badge">LVL @Level (@((int)LevelProgress)%)</div>
                            @* Clearance Badge *@
                            <div class="clearance-badge">CL @Clearance</div>
                        </div>
                    </div>

                    @* Role and Health Section *@
                    <div class="vitals-row">
                        <div class="role-container">
                             <div class="role-tag @RoleLower">@RoleLabel</div>
                        </div>
                        
                        <div class="health-container">
                            <div class="health-bar-bg">
                                <div class="health-bar-fill" style="width: @(Health)%"></div>
                            </div>
                            <label class="health-text">@Health</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Bottom Right: Ammo *@
        @if (LocalPlayer is not null && LocalPlayer.IsGunEquipped)
        {
            <div class="ammo-card upscale-hud">
                <div class="ammo-numbers">
                    <span class="current">@LocalPlayer.CurrentAmmo</span>
                    <span class="slash">/</span>
                    <span class="max">@LocalPlayer.CurrentMagazineSize</span>
                </div>
            </div>
        }

        @* Chat Logic *@
        @if (ChatMessages.Count > 0 || IsChatOpen)
        {
            <div class="chat-container @(IsChatOpen ? "open" : "")">
                <div class="chat-log">
                    @foreach (var msg in ChatMessages)
                    {
                        <div class="chat-line">@msg</div>
                    }
                </div>
                @if (IsChatOpen)
                {
                    <OrionChatTextEntry class="chat-input" @ref="ChatInput" />
                }
            </div>
        }
    </div>
</root>

@code {

    private OrionPlayerController GetLocalPlayer()
    {
        return Scene.GetAllComponents<OrionPlayerController>()
            .FirstOrDefault( x => x.IsValid() && x.GameObject.Network.IsOwner && !x.IsProxy );
    }

    private OrionPlayerController LocalPlayer => GetLocalPlayer();

    float TimeSinceDamage => LocalPlayer.IsValid() ? LocalPlayer.TimeSinceLastDamage : 100f;
    float TimeSinceConfirmedHit => LocalPlayer.IsValid() ? LocalPlayer.TimeSinceLastConfirmedHit : 100f;

    Panel DamageVignette;
    OrionChatTextEntry ChatInput;

    float HealthFraction
    {
        get
        {
            if ( !LocalPlayer.IsValid() || LocalPlayer.MaxHealth <= 0f )
                return 1f;

            return Math.Clamp( LocalPlayer.Health / LocalPlayer.MaxHealth, 0f, 1f );
        }
    }

    float LowHealthAmount => 1f - HealthFraction;

    float DamagePulseAmount
    {
        get
        {
            if ( !LocalPlayer.IsValid() )
                return 0f;

            const float pulseDuration = 0.45f;
            return 1f - Math.Clamp( TimeSinceDamage / pulseDuration, 0f, 1f );
        }
    }

    void UpdateDamageVignette()
    {
        if ( DamageVignette is null || !DamageVignette.IsValid() )
            return;

        if ( !LocalPlayer.IsValid() )
        {
            DamageVignette.Style.Opacity = 0f;
            return;
        }

        float baseOpacity = LowHealthAmount * 0.75f;
        float pulseOpacity = DamagePulseAmount * 0.65f;
        float finalOpacity = Math.Clamp( baseOpacity + pulseOpacity, 0f, 1f );

        float borderThickness = 18f + (LowHealthAmount * 90f);

        DamageVignette.Style.Opacity = finalOpacity;
        DamageVignette.Style.BorderTopWidth = borderThickness;
        DamageVignette.Style.BorderBottomWidth = borderThickness;
        DamageVignette.Style.BorderLeftWidth = borderThickness;
        DamageVignette.Style.BorderRightWidth = borderThickness;
    }

protected override int BuildHash()
{
    if ( !LocalPlayer.IsValid() )
        return 0;

    int playerHash = HashCode.Combine(
        LocalPlayer.HasGun,
        LocalPlayer.CurrentSlot,
        LocalPlayer.CurrentAmmo,
        LocalPlayer.CurrentMagazineSize,
        LocalPlayer.Health,
        LocalPlayer.MaxHealth,
        LocalPlayer.IsDead
    );

    int hudHash = HashCode.Combine(
        HudState?.ShowChat ?? false,
        HudState?.ChatDraft ?? "",
        HudState?.IsVoiceKeyHeld ?? false
    );

    return HashCode.Combine( playerHash, hudHash );
}

    OrionHUDState GetHudState()
    {
        return Scene.GetAllComponents<OrionHUDState>().FirstOrDefault( x => x.IsValid() );
    }

    OrionHUDState HudState => GetHudState();

    bool IsChatOpen => HudState?.ShowChat ?? false;

    List<string> ChatMessages => HudState?.ChatMessages ?? new();

    string ChatDraft
    {
        get => HudState?.ChatDraft ?? "";
        set
        {
            if ( HudState.IsValid() )
                HudState.ChatDraft = eSafeString( value );
        }
    }

    void OnChatTextEdited( string value )
    {
	    ChatDraft = value ?? string.Empty;
    }

    void SubmitChatFromHud()
    {
	    var player = GetLocalPlayer();
	    if ( !player.IsValid() )
		    return;

	    player.SubmitChatMessage();
    }

    void CancelChatFromHud()
    {
	    var player = GetLocalPlayer();
	    if ( !player.IsValid() )
		    return;

	    player.CloseChat();
    }

    private static string eSafeString( string value ) => value ?? string.Empty;

    protected override void OnStart()
    {
        OrionChatManager.OnChatMessageReceived += OnChatMessageReceived;
    }

    protected override void OnDisabled()
    {
        OrionChatManager.OnChatMessageReceived -= OnChatMessageReceived;
    }

    void OnChatMessageReceived( string playerName, string message )
    {
        if ( HudState.IsValid() )
        {
            HudState.AddChatMessage( playerName, message );
            StateHasChanged();
        }
    }

    private void RespawnLocalPlayer()
    {
        var player = GetLocalPlayer();
        if ( !player.IsValid() )
            return;

        if ( !player.IsLocalDead )
            return;

        player.Respawn();
    }

    private OrionPlayerController GetPlayer()
    {
        return GetLocalPlayer();
    }

    private OrionPlayerController GetPlayer( bool includeDead )
    {
        var player = GetLocalPlayer();

        if ( !player.IsValid() )
            return null;

        if ( !includeDead && player.IsDead )
            return null;

        return player;
    }

    private OrionHUDState GetHUDState() => Scene.GetAllComponents<OrionHUDState>().FirstOrDefault();

    bool IsDead => GetPlayer( true )?.IsLocalDead ?? false;
    bool ShowDenied => GetHUDState().IsValid() && GetHUDState().ShowDenied;

    bool ShowXpGiftPopup => GetPlayer( true )?.ShowXpPopup ?? false;
    string XpGiftPopupMessage => GetPlayer( true )?.XpPopupMessage ?? "";

    string LocalName => Connection.Local?.DisplayName?.ToUpper() ?? "PLAYER";
    int Health => GetPlayer( true ).IsValid() ? (int)GetPlayer( true ).Health : 100;
    int Level => GetPlayer( true )?.PlayerLevel ?? 1;
    int Clearance => GetPlayer( true )?.ClearanceLevel ?? 0;
    string Role => GetPlayer( true )?.CurrentRole.ToString() ?? "UNASSIGNED";
    string RoleLower => Role.Replace( " ", "" ).ToLower();
    string RoleLabel => Role.Replace( "Class", " CLASS" ).ToUpper();

    float LevelProgress
    {
        get
        {
            var p = GetPlayer( true );
            if ( p == null ) return 0f;

            float targetXp = p.PlayerLevel * 600f;
            return Math.Clamp( (p.Experience / targetXp) * 100f, 0f, 100f );
        }
    }

        bool _wasChatOpen;
        bool _blockChatHotkeysUntilReleased;

        protected override void OnUpdate()
        {
	        UpdateDamageVignette();

	        var state = GetHUDState();
	        if ( !state.IsValid() )
	        {
		        StateHasChanged();
		        return;
	        }

	        if ( state.ShowDenied && state.DeniedTimer > 2.0f )
	        {
		        state.ShowDenied = false;
	        }

	        if ( state.ShowChat && !_wasChatOpen )
	        {
		        _blockChatHotkeysUntilReleased = true;
	        }

	        _wasChatOpen = state.ShowChat;

	        if ( state.ShowChat )
	        {
		        // Don't let the same key that opened chat instantly submit it.
		        if ( _blockChatHotkeysUntilReleased )
		        {
			        bool openingKeysStillHeld =
				        Input.Keyboard.Down( "ENTER" ) ||
				        Input.Keyboard.Down( "KP_ENTER" ) ||
				        Input.Keyboard.Down( "T" );

			        if ( !openingKeysStillHeld )
			        {
				        _blockChatHotkeysUntilReleased = false;
			        }
		        }
	        }

	        StateHasChanged();
        }

        protected override void OnTreeBuilt()
        {
	        base.OnTreeBuilt();

	        var state = GetHUDState();
	        if ( !state.IsValid() || !state.ShowChat )
		        return;

	        if ( ChatInput is null || !ChatInput.IsValid() )
		        return;

	        ChatInput.AcceptsFocus = true;
	        ChatInput.Placeholder = "Type message...";
	        ChatInput.Edited = OnChatTextEdited;
	        ChatInput.Submitted = SubmitChatFromHud;
	        ChatInput.Cancelled = CancelChatFromHud;

	        if ( !ChatInput.HasFocus )
	        {
		        ChatInput.Text = ChatDraft ?? string.Empty;
		        ChatInput.Focus();
	        }
        }
}
