@using Sandbox
@using Sandbox.UI
@using System.Linq
@using System;
@inherits PanelComponent

<root style="pointer-events: @(IsDead ? "all" : "none")">
    <div class="hud-root @(IsDead ? "is-dead" : "")">

        <div class="damage-vignette" @ref="DamageVignette"></div>

        <div class="crosshair-dot"></div>

        <div class="hitmarker @(TimeSinceConfirmedHit < 0.15f ? "visible" : "")">
    <div class="mark lt"></div>
    <div class="mark rt"></div>
    <div class="mark lb"></div>
    <div class="mark rb"></div>
    </div>


        <div class="top-bar">
            <div class="player-card">
                <div class="player-main">
                    <label class="player-name">@LocalName</label>

                    <div class="badge-row">
                        <div class="role-badge @RoleLower">
                            <label>@RoleLabel</label>
                        </div>

                        <div class="clearance-badge">
                            <label class="badge-title">CLEARANCE</label>
                            <label class="badge-value">LVL @Clearance</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="progress-card">
                <label class="eyebrow">PROGRESSION</label>
                <label class="level-value">LEVEL @Level</label>
                <div class="progress-track">
                    <div class="progress-fill" style="width: @(LevelProgress)%"></div>
                </div>
            </div>
        </div>

        <div class="bottom-bar">
            <div class="health-card">
                <div class="health-top">
                    <label class="eyebrow">VITAL SIGNS</label>
                    <label class="health-value">@Health%</label>
                </div>

                <div class="bar-track health-track">
                    <div class="bar-fill health-fill" style="width: @(Health)%"></div>
                </div>
            </div>
        </div>


        @if ( ShowDenied )
        {
            <div class="access-denied-popup">
                <label class="denied-title">ACCESS DENIED</label>
                <label class="denied-sub">INSUFFICIENT CLEARANCE</label>
            </div>
        }


        @if ( ShowXpGiftPopup )
{
    <div class="xp-popup">
        <label>@XpGiftPopupMessage</label>
    </div>
}


        @if ( LocalPlayer is not null && LocalPlayer.IsGunEquipped )
{
	<div class="ammo">
		<span class="current">@LocalPlayer.CurrentAmmo</span>
		<span class="slash">/</span>
		<span class="max">@LocalPlayer.CurrentMagazineSize</span>
	</div>
}


         @if ( IsDead )
        {
            var p = GetLocalPlayer();
            var timeLeft = Math.Max( 0, (int)(10 - (p?.TimeSinceDeath ?? 0)) );

            <div class="death-screen">
                <div class="death-overlay">
                    <label class="death-title">TERMINATED</label>
                    <label class="death-sub">SUBJECT: @LocalName</label>

                    @if ( timeLeft > 0 )
                    {
                        <label class="death-sub">RESPAWN AVAILABLE IN @timeLeft</label>
                    }
                    else
                    {
                        <button class="respawn-button" @onclick=@RespawnLocalPlayer>
                            RESPAWN NOW
                        </button>
                    }
                </div>
            </div>
        }

    </div>
</root>

@code {

private OrionPlayerController GetLocalPlayer()
    {
        return Scene.GetAllComponents<OrionPlayerController>()
            .FirstOrDefault( x => x.IsValid() && x.GameObject.Network.IsOwner && !x.IsProxy );
    }

private OrionPlayerController LocalPlayer => GetLocalPlayer();



float TimeSinceDamage => LocalPlayer.IsValid() ? LocalPlayer.TimeSinceLastDamage : 100f;
float TimeSinceConfirmedHit => LocalPlayer.IsValid() ? LocalPlayer.TimeSinceLastConfirmedHit : 100f;
Panel DamageVignette;


float HealthFraction
{
	get
	{
		if ( !LocalPlayer.IsValid() || LocalPlayer.MaxHealth <= 0f )
			return 1f;

		return Math.Clamp( LocalPlayer.Health / LocalPlayer.MaxHealth, 0f, 1f );
	}
}

float LowHealthAmount => 1f - HealthFraction;

float DamagePulseAmount
{
	get
	{
		if ( !LocalPlayer.IsValid() )
			return 0f;

		const float pulseDuration = 0.45f;
		return 1f - Math.Clamp( TimeSinceDamage / pulseDuration, 0f, 1f );
	}
}

void UpdateDamageVignette()
{
	if ( DamageVignette is null || !DamageVignette.IsValid() )
		return;

	if ( !LocalPlayer.IsValid() )
	{
		DamageVignette.Style.Opacity = 0f;
		return;
	}

	float baseOpacity = LowHealthAmount * 0.75f;
	float pulseOpacity = DamagePulseAmount * 0.65f;
	float finalOpacity = Math.Clamp( baseOpacity + pulseOpacity, 0f, 1f );

	// Make the red border thicker as health gets lower
	float borderThickness = 18f + (LowHealthAmount * 90f);

	DamageVignette.Style.Opacity = finalOpacity;
	DamageVignette.Style.BorderTopWidth = borderThickness;
	DamageVignette.Style.BorderBottomWidth = borderThickness;
	DamageVignette.Style.BorderLeftWidth = borderThickness;
	DamageVignette.Style.BorderRightWidth = borderThickness;
}


protected override int BuildHash()
{
	if ( !LocalPlayer.IsValid() )
		return 0;

	return HashCode.Combine(
		LocalPlayer.HasGun,
		LocalPlayer.CurrentSlot,
		LocalPlayer.CurrentAmmo,
		LocalPlayer.CurrentMagazineSize,
		LocalPlayer.Health,
		LocalPlayer.MaxHealth,
		LocalPlayer.IsDead
	);
}

        private void RespawnLocalPlayer()
        {
            var player = GetLocalPlayer();
            if ( !player.IsValid() )
                return;

            if ( !player.IsLocalDead )
                return;

            player.Respawn();
        }

    private OrionPlayerController GetPlayer()
    {
        return GetLocalPlayer();
    }

    private OrionPlayerController GetPlayer( bool includeDead )
    {
        var player = GetLocalPlayer();

        if ( !player.IsValid() )
            return null;

        if ( !includeDead && player.IsDead )
            return null;

        return player;
    }

    private OrionHUDState GetHUDState() => Scene.GetAllComponents<OrionHUDState>().FirstOrDefault();

    bool IsDead => GetPlayer(true)?.IsLocalDead ?? false;
    bool ShowDenied => GetHUDState().IsValid() && GetHUDState().ShowDenied;

    bool ShowXpGiftPopup => GetPlayer(true)?.ShowXpPopup ?? false;
    string XpGiftPopupMessage => GetPlayer(true)?.XpPopupMessage ?? "";

    string LocalName => Connection.Local?.DisplayName?.ToUpper() ?? "PLAYER";
    int Health => GetPlayer(true).IsValid() ? (int)GetPlayer(true).Health : 100;
    int Level => GetPlayer(true)?.PlayerLevel ?? 1;
    int Clearance => GetPlayer(true)?.ClearanceLevel ?? 0;
    string Role => GetPlayer(true)?.CurrentRole.ToString() ?? "UNASSIGNED";
    string RoleLower => Role.Replace(" ", "").ToLower();
    string RoleLabel => Role.Replace("Class", " CLASS").ToUpper();

    float LevelProgress
    {
        get
        {
            var p = GetPlayer(true);
            if ( p == null ) return 0f;

            // Calculate XP needed for the NEXT level
            // Level 1 -> 2 needs 600, Level 2 -> 3 needs 1200
            float targetXp = p.PlayerLevel * 600f;
        
            // This calculates progress relative to the current level's goal
            return Math.Clamp((p.Experience / targetXp) * 100f, 0f, 100f);
        }
    }

    protected override void OnUpdate()
    {
        UpdateDamageVignette();
        StateHasChanged();

        var state = GetHUDState();
        if ( state.IsValid() && state.ShowDenied && state.DeniedTimer > 2.0f )
        {
            state.ShowDenied = false;
        }
    }
}
